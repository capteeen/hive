# HIVE environment. Copy to .env.local for local work; on Vercel set the same names under
# Project → Settings → Environment Variables. Step by step: GO-LIVE.md. Check with `npm run check:live`
# (locally) and https://<your site>/api/health (deployed).
#
# With nothing set, HIVE runs in preview (mock) mode on a local file store: launches are simulated,
# nothing touches the chain. Delete the DATA_DIR folder (default .data) to start over locally.

# ---- mode ----------------------------------------------------------------------------------------
# live = real pump.fun coins and real transactions. Leave unset (mock) until GO-LIVE.md says so.
LAUNCH_MODE=
# The engine only records what it would do until this is 0. Keep 1 for the first day live.
ENGINE_DRY_RUN=1
# 1 = also show 60 simulated demo hives (local play only). Unset / 0 in production.
NEXT_PUBLIC_DEMO_HIVES=

# ---- Supabase (required live, and for multi-user on Vercel) ------------------------------------
# Project Settings → API. The service-role key is server-only: never prefix it with NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---- keys --------------------------------------------------------------------------------------
# Encrypts every queen and mint key. `openssl rand -base64 32`. BACK IT UP OFFLINE: losing it loses
# every queen wallet and the SOL in it. Never change it once live.
QUEEN_KEY_SECRET=
# Bearer token the cron service sends to /api/cron/*. `openssl rand -hex 32`.
CRON_SECRET=

# ---- Solana ------------------------------------------------------------------------------------
# Server RPC (paid; it may carry an API key, it never reaches the browser).
SOLANA_RPC_URL=
# Browser RPC for the wallet (public: use a key restricted to your domain).
NEXT_PUBLIC_RPC=
# Holder counts (bees) and abandon payouts. Helius free tier is fine to start.
HELIUS_API_KEY=
PRIORITY_FEE_SOL=0.0005
SLIPPAGE_PCT=10

# ---- the $HIVE hub (harvest). Leave unset until $HIVE exists: harvests are skipped until then. ----
HUB_WALLET=
# base58 secret key or Solana CLI JSON byte array; its public key must equal HUB_WALLET.
HUB_WALLET_SECRET=
HUB_TOKEN_MINT=

# ---- site --------------------------------------------------------------------------------------
# The public URL (coin metadata links here).
NEXT_PUBLIC_SITE_URL=

# ---- local / self-hosted only ------------------------------------------------------------------
# File store location without Supabase (default .data, /tmp/hive-data on Vercel).
DATA_DIR=
# Reverse proxies in front of a self-hosted server (1 behind nginx / Caddy). Ignored on Vercel.
TRUST_PROXY=
# 0 = do not run the mock engine inside a local server.
ENGINE_AUTORUN=
